{
  "name": "dsh-ventus-research",
  "version": "0.1.0",
  "description": "科研工作流插件：把科研循环建模成 claim 生命周期（推导→验证→证据→裁决→成稿），沉淀进 .rb-state.json，rb_verify 硬闸门 + signature token 人工裁决。独立 bundle 行挂载，不依赖整合包其它子插件。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "0.22.14",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test lib/gates.spec.js"
  }
}